---
import ToolCard from "../components/ToolCard.astro";
import Base from "../layouts/Base.astro";
import { TOOLS } from "../lib/tools";
---

<Base>
  <section class="hero">
    <h1>
      Cosense をもっと面白く、<br /><span class="grad">もっと強力に</span>
    </h1>
    <p>Cosense のための道具を置いています。使いたいものから入ってください。</p>
  </section>

  <div class="tool-grid">
    {TOOLS.map((tool) => <ToolCard tool={tool} />)}
  </div>
</Base>
