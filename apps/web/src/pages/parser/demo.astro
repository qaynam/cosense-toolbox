---
import { Code } from "astro:components";
import Doc from "../../layouts/Doc.astro";
import { html as basicHtml } from "../../lib/demo-basic";
import { html as iconsHtml } from "../../lib/demo-icons";

const raw = import.meta.glob("../../lib/demo-*.ts", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const demos = [
  {
    id: "basic",
    heading: "そのまま変換する",
    code: raw["../../lib/demo-basic.ts"],
    document: basicHtml,
  },
  {
    id: "icons",
    heading: "リンク先とアイコンを渡す",
    code: raw["../../lib/demo-icons.ts"],
    document: iconsHtml,
  },
];
---

<Doc
  title="例"
  description="Cosense の記法を parse して toHtml で描画した結果と、その実装"
>
  <h1>例</h1>
  <p class="lead">
    本家の <a href="https://scrapbox.io/help-jp/その他の書き方" target="_blank"
      >/help-jp/その他の書き方</a
    > を変換したものです。実装はそのまま動くコードで、この画面もそれで作っています。
  </p>

  <h2 id="そのままHTMLに変換する">{demos[0].heading}</h2>
  <p class="lead">
    <code>parse</code> して <code>toHtml</code> に渡すだけの、いちばん短い書きかたです。
  </p>

  <div class="demo">
    <div class="demo-tabs" role="tablist">
      <button type="button" role="tab" data-demo-tab="code" aria-selected="true"
        >実装</button
      >
      <button
        type="button"
        role="tab"
        data-demo-tab="view"
        aria-selected="false">描画</button
      >
    </div>
    <div data-demo-panel="code" class="demo-panel">
      <Code lang="ts" code={demos[0].code} />
    </div>
    <div data-demo-panel="view" class="demo-panel" hidden>
      <iframe title={demos[0].heading} srcdoc={demos[0].document}></iframe>
    </div>
  </div>

  <p class="lead">
    ただし、アイコンが画像になりません。<code>[rakusai.icon]</code> の画像は
    <code>/api/pages/{"{project}"}/rakusai/icon</code>
    にありますが、記法にプロジェクト名が書かれていないので、パーサーには URL を組み立てられないからです。
    リンク先が <code>/タイトル</code> になっているのも同じ理由です。
  </p>

  <h2 id="リンク先とアイコンを渡す">{demos[1].heading}</h2>
  <p class="lead">
    そこで <a href="/parser/html/#pageurl">pageUrl</a> と <a
      href="/parser/html/#iconimageurl">iconImageUrl</a
    > を渡します。プロジェクト名を知っているのは呼び出し側なので、URL の組み立ても呼び出し側が行います。
  </p>

  <div class="demo">
    <div class="demo-tabs" role="tablist">
      <button type="button" role="tab" data-demo-tab="code" aria-selected="true"
        >実装</button
      >
      <button
        type="button"
        role="tab"
        data-demo-tab="view"
        aria-selected="false">描画</button
      >
    </div>
    <div data-demo-panel="code" class="demo-panel">
      <Code lang="ts" code={demos[1].code} />
    </div>
    <div data-demo-panel="view" class="demo-panel" hidden>
      <iframe title={demos[1].heading} srcdoc={demos[1].document}></iframe>
    </div>
  </div>
</Doc>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>(".demo")) {
    const tabs = demo.querySelectorAll<HTMLButtonElement>("[data-demo-tab]");
    const panels = demo.querySelectorAll<HTMLElement>("[data-demo-panel]");

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const name = tab.dataset.demoTab;
        for (const other of tabs)
          other.setAttribute("aria-selected", String(other === tab));
        for (const panel of panels)
          panel.hidden = panel.dataset.demoPanel !== name;
      });
    }
  }
</script>

<style>
  .lead {
    color: var(--text-dim);
  }

  .demo-tabs {
    display: flex;
    gap: 4px;
    margin: 28px 0 0;
  }

  .demo-tabs button {
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    background: var(--bg);
    color: var(--text-dim);
    font-size: 13.5px;
    cursor: pointer;
  }

  .demo-tabs button[aria-selected="true"] {
    background: var(--bg-elev);
    color: var(--text);
  }

  .demo-panel {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 0 var(--radius) var(--radius) var(--radius);
    overflow: auto;
  }

  .demo-panel iframe {
    display: block;
    width: 100%;
    height: 70vh;
    border: 0;
    background: #fefefe;
  }
</style>
