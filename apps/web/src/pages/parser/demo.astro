---
import { Code } from "astro:components";
import { parse } from "@cosense-toolbox/parser";
import { toHtml, toPlainText } from "@cosense-toolbox/parser/compile";
import defaultStyle from "@cosense-toolbox/style/style.css?raw";
import Doc from "../../layouts/Doc.astro";

// 本家の「その他の書き方」ページの内容。記法をひととおり含んでいる。
const source = [
	"その他の書き方",
	"基本的な[ブラケティング]の他にも、色々な[記法]があります",
	"",
	"外部リンク (一般のWebページへのリンク)",
	" URLを書くとリンクになる",
	"  https://yahoo.co.jp",
	"	`[URL タイトル]`",
	"	 [https://yahoo.com Yahoo!]",
	" `[タイトル URL]`逆順でもok",
	"  [Yahoo! https://yahoo.com]",
	"",
	"画像",
	"	`[画像URL]`",
	"  [https://i.gyazo.com/da78df293f9e83a74b5402411e2f2e01.png]",
	" `[[画像URL]]`",
	"  横幅いっぱい、高さ制限無しで大きな画像を表示",
	"",
	"リンク付き画像",
	"	`[リンク先URL 画像URL]`",
	"  [http://yahoo.co.jp https://i.gyazo.com/da78df293f9e83a74b5402411e2f2e01.png]",
	"",
	"別プロジェクトへのリンク",
	" `/プロジェクト名/ページ名`",
	" [/icons]",
	" [/icons/すごい]",
	"",
	"アイコン",
	" [rakusai.icon]",
	" [/icons/炎上.icon]",
	"",
	"[数式]",
	" [$ \\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}]",
	"",
	"[HashTag]",
	" #HashTag",
	"",
	"引用",
	" > 行頭に`>`を書くと引用になります",
	"",
	"コード",
	" バッククオート`\\``で囲む",
	"  `function() {  return \\`hello\\` }`",
	"",
	"[コードブロック]",
	" code:hello.js",
	"  function () {",
	"    alert(document.location.href)",
	'    console.log("hello")',
	"    // コメントも書けるぞ",
	"  }",
	"",
	"[テーブル]",
	" `table:テーブル名` の後、インデントしてtab区切り",
	" table:テーブルの例",
	"  abc	def",
	"  12345	6789",
	"  長い長い文字列	短い文字列",
	"",
	"コマンドライン",
	" 行頭に`$`もしくは`%`",
	" $ git reset --hard HEAD^",
	" % cp a.txt b.txt",
	"",
	"[[強調]]と[*** 大きな文字]",
	"	`[[強調]]` ⇒ [[強調]]",
	" `[* 強調]` ⇒ [* 強調]",
	" `[**** もっと大きな文字]` => [**** もっと大きな文字]",
	"",
	"[/ 斜体]",
	" `[/ 斜体文字]` ⇒ [/ 斜体文字]",
	" `[/* 太字斜体文字]` => [/* 太字斜体文字]",
	"",
	"[- 打ち消し線]",
	" `[- 打ち消し]` ⇒ [- 打ち消し]",
].join("\n");

const page = parse(source);
const html = toHtml(page);
const text = toPlainText(page);

// このページに載せているコード。実際に上で動かしているものと同じにする。
const example = `import { parse } from '@cosense-toolbox/parser'
import { toHtml, toPlainText } from '@cosense-toolbox/parser/compile'

const page = parse(source)

const html = toHtml(page)
const text = toPlainText(page)`;

// iframe に入れて周りの CSS から切り離す。
// style は <head> に一度だけ置けばよいので toHtml の style オプションは使わない。
const document = `<!doctype html><html lang="ja"><head><meta charset="utf-8"><style>${defaultStyle}</style></head><body>${html}</body></html>`;

const tabs = [
	{ id: "rendered", label: "表示" },
	{ id: "source", label: "元の記法" },
	{ id: "html", label: "toHtml の出力" },
	{ id: "plain", label: "toPlainText の出力" },
];
---

<Doc title="例" description="Cosense の記法をひととおり parse して toHtml で描画した結果">
	<h1>例</h1>
	<p class="lead">
		本家の <a href="https://scrapbox.io/help-jp/その他の書き方" target="_blank">その他の書き方</a> ページを、下のコードだけで変換した結果です。オプションを何も渡していないので、これが既定の出力になります。
	</p>

	<Code code={example} lang="ts" theme="github-dark" />

	<p class="lead">
		リンク先が <code>/タイトル</code> になっているのは既定の動作で、実際のプロジェクトに向けるには <a href="/parser/html/#pageurl">pageUrl</a> を渡します。
		アイコンが画像でなく名前で出ているのも同じで、<a href="/parser/html/#iconimageurl">iconImageUrl</a> を渡すと画像になります。
		コードブロックに色を付けるには <a href="/parser/html/#highlight">highlight</a> にハイライタを挿します。
	</p>

	<div class="demo">
		<div class="demo-tabs" role="tablist">
			{
				tabs.map((tab, index) => (
					<button
						type="button"
						role="tab"
						data-demo-tab={tab.id}
						aria-selected={index === 0 ? "true" : "false"}
					>
						{tab.label}
					</button>
				))
			}
		</div>

		<div data-demo-panel="rendered" class="demo-panel">
			<iframe title="toHtml の出力" srcdoc={document}></iframe>
		</div>
		<pre data-demo-panel="source" class="demo-panel" hidden>{source}</pre>
		<pre data-demo-panel="html" class="demo-panel" hidden>{html}</pre>
		<pre data-demo-panel="plain" class="demo-panel" hidden>{text}</pre>
	</div>
</Doc>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>("[data-demo-tab]");
	const panels = document.querySelectorAll<HTMLElement>("[data-demo-panel]");

	for (const tab of tabs) {
		tab.addEventListener("click", () => {
			const name = tab.dataset.demoTab;
			for (const other of tabs) other.setAttribute("aria-selected", String(other === tab));
			for (const panel of panels) panel.hidden = panel.dataset.demoPanel !== name;
		});
	}
</script>

<style>
	.lead {
		color: var(--text-dim);
	}

	.demo-tabs {
		display: flex;
		gap: 4px;
		margin: 28px 0 0;
	}

	.demo-tabs button {
		padding: 8px 16px;
		border: 1px solid var(--border);
		border-bottom: 0;
		border-radius: 8px 8px 0 0;
		background: var(--bg);
		color: var(--text-dim);
		font-size: 13.5px;
		cursor: pointer;
	}

	.demo-tabs button[aria-selected="true"] {
		background: var(--bg-elev);
		color: var(--text);
	}

	.demo-panel {
		margin: 0;
		border: 1px solid var(--border);
		border-radius: 0 var(--radius) var(--radius) var(--radius);
		overflow: auto;
	}

	.demo-panel iframe {
		display: block;
		width: 100%;
		height: 70vh;
		border: 0;
		background: #fefefe;
	}

	pre.demo-panel {
		max-height: 70vh;
		padding: 20px;
		background: var(--code-bg);
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.7;
		white-space: pre-wrap;
	}
</style>
