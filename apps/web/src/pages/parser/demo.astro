---
import { Code } from "astro:components";
import Doc from "../../layouts/Doc.astro";
import { htmlDemo, htmlDemoWithResolvedLinks, SOURCE } from "../../lib/html-demo";

const htmlDemoCode = import.meta.glob("../../lib/html-demo.ts", {
  query: "?raw",
  import: "default",
  eager: true,
})["../../lib/html-demo.ts"] as string;

/**
 * html-demo.ts から関数を 1 つ切り出す。直前の JSDoc も含める。
 * ここに実装を書き写すと本体とずれるので、ファイルから読む。
 */
function pickFunction(code: string, name: string): string {
  const lines = code.split("\n");
  const declared = lines.findIndex((line) =>
    line.includes(`function ${name}(${SOURCE}`),
  );
  if (declared < 0) return code;

  let from = declared;
  while (from > 0 && /^\s*(\/\*\*|\*)/.test(lines[from - 1])) from--;
  const closed = lines.findIndex((line, i) => i > declared && line === "}");

  return lines.slice(from, closed + 1).join("\n");
}

const demos = [
  {
    id: "plain",
    heading: "そのまま変換する",
    code: pickFunction(htmlDemoCode, "htmlDemo"),
    document: htmlDemo(),
  },
  {
    id: "resolved",
    heading: "リンクとアイコンを解決する",
    code: pickFunction(htmlDemoCode, "htmlDemoWithResolvedLinks"),
    document: await htmlDemoWithResolvedLinks(),
  },
];
---

<Doc
  title="例"
  description="Cosense の記法をひととおり parse して toHtml で描画した結果"
>
  <h1>例</h1>
  <p class="lead">
    <a href="https://scrapbox.io/help-jp/その他の書き方" target="_blank"
      >/help-jp/その他の書き方</a
    > ページを、下のコードだけで変換した結果です。
  </p>

  <h2 id="そのまま変換する">{demos[0].heading}</h2>
  <p class="lead">
    <code>toHtml</code> にオプションを渡していないので、リンク先が <code
      >/タイトル</code
    > になり、アイコンはユーザー名のテキストリンクになります。
  </p>

  <div class="demo">
    <div class="demo-tabs" role="tablist">
      <button type="button" role="tab" data-demo-tab="code" aria-selected="true"
        >実装</button
      >
      <button
        type="button"
        role="tab"
        data-demo-tab="view"
        aria-selected="false">描画</button
      >
    </div>
    <div data-demo-panel="code" class="demo-panel">
      <Code lang="ts" code={demos[0].code} />
    </div>
    <div data-demo-panel="view" class="demo-panel" hidden>
      <iframe title={demos[0].heading} srcdoc={demos[0].document}></iframe>
    </div>
  </div>

  <h2 id="リンクとアイコンを解決する">{demos[1].heading}</h2>
  <p class="lead">
    <a href="/parser/html/#pageurl">pageUrl</a> と <a href="/parser/html/#iconimageurl">iconImageUrl</a> を渡すと、リンク先が本家のページに向き、アイコンが画像になります。 どちらも記法には書かれていない情報なので、外から渡して補います。
  </p>

  <div class="demo">
    <div class="demo-tabs" role="tablist">
      <button type="button" role="tab" data-demo-tab="code" aria-selected="true"
        >実装</button
      >
      <button
        type="button"
        role="tab"
        data-demo-tab="view"
        aria-selected="false">描画</button
      >
    </div>
    <div data-demo-panel="code" class="demo-panel">
      <Code lang="ts" code={demos[1].code} />
    </div>
    <div data-demo-panel="view" class="demo-panel" hidden>
      <iframe title={demos[1].heading} srcdoc={demos[1].document}></iframe>
    </div>
  </div>
</Doc>

<script>
  // .demo が 2 つ以上あるので、タブの切り替えはその中だけに閉じる。
  for (const demo of document.querySelectorAll<HTMLElement>(".demo")) {
    const tabs = demo.querySelectorAll<HTMLButtonElement>("[data-demo-tab]");
    const panels = demo.querySelectorAll<HTMLElement>("[data-demo-panel]");

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const name = tab.dataset.demoTab;
        for (const other of tabs)
          other.setAttribute("aria-selected", String(other === tab));
        for (const panel of panels)
          panel.hidden = panel.dataset.demoPanel !== name;
      });
    }
  }
</script>

<style>
  .lead {
    color: var(--text-dim);
  }

  .demo-tabs {
    display: flex;
    gap: 4px;
    margin: 28px 0 0;
  }

  .demo-tabs button {
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    background: var(--bg);
    color: var(--text-dim);
    font-size: 13.5px;
    cursor: pointer;
  }

  .demo-tabs button[aria-selected="true"] {
    background: var(--bg-elev);
    color: var(--text);
  }

  .demo-panel {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 0 var(--radius) var(--radius) var(--radius);
    overflow: auto;
  }

  .demo-panel iframe {
    display: block;
    width: 100%;
    height: 70vh;
    border: 0;
    background: #fefefe;
  }

  pre.demo-panel {
    max-height: 70vh;
    padding: 20px;
    background: var(--code-bg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-wrap;
  }
</style>
