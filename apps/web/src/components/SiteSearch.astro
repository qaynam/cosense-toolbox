---
import { DOC_GROUPS } from "../lib/docs"

// 検索の索引 (Pagefind) はビルドの後にしか無いので、開発中はページの一覧から探す。
const fallback = DOC_GROUPS.flatMap((group) =>
  group.pages.map((page) => ({
    url: page.href,
    title: page.label,
    excerpt: page.description,
    text: `${page.label} ${page.description} ${page.keywords} ${group.label}`.toLocaleLowerCase(
      "ja",
    ),
  })),
)
---

<button class="icon-btn search-btn" type="button" data-search-open aria-label="ドキュメントを検索">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="m20 20-3.5-3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </svg>
  <kbd class="search-kbd" aria-hidden="true">
    ⌘K
  </kbd>
</button>

<dialog class="search-dialog" aria-label="ドキュメントを検索">
  <form method="dialog" class="search-form">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path
        d="m20 20-3.5-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
    </svg>
    <input
      class="search-input"
      type="search"
      placeholder="ページ名・機能名・本文から探す"
      autocomplete="off"
      aria-controls="search-results"
    />
    <kbd class="search-kbd">Esc</kbd>
  </form>
  <ul class="search-results" id="search-results" role="listbox"></ul>
  <p class="search-status" aria-live="polite"></p>
</dialog>

<script
  is:inline
  type="application/json"
  id="search-fallback"
  set:html={JSON.stringify(fallback)}
/>
<script>
  interface Result {
    url: string
    title: string
    /** Pagefind の抜粋は一致した語を <mark> で囲んだ HTML。ページの一覧から探したときは素の文字 */
    excerpt: string
    html: boolean
  }

  interface Pagefind {
    debouncedSearch: (query: string) => Promise<{
      results: { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> }[]
    } | null>
  }

  const dialog = document.querySelector<HTMLDialogElement>(".search-dialog")
  const input = dialog?.querySelector<HTMLInputElement>(".search-input")
  const list = dialog?.querySelector<HTMLUListElement>(".search-results")
  const status = dialog?.querySelector<HTMLElement>(".search-status")
  const fallback: { url: string; title: string; excerpt: string; text: string }[] = JSON.parse(
    document.querySelector("#search-fallback")?.textContent ?? "[]",
  )

  // 索引はビルドの後に dist/pagefind/ に作られる。無ければ (開発中) ページの一覧から探す。
  // バンドラーの外にあるファイルなので、ブラウザの import() でそのまま読む。
  // import() と書くと Vite が preload の包みを付け、Astro が埋め込んだ script では動かなくなる。
  const importModule = new Function("url", "return import(url)") as (
    url: string,
  ) => Promise<Pagefind>
  let pagefind: Promise<Pagefind | null> | undefined
  const loadPagefind = (): Promise<Pagefind | null> => {
    pagefind ??= importModule("/pagefind/pagefind.js").catch(() => null)
    return pagefind
  }

  const searchFallback = (query: string): Result[] => {
    const words = query.toLocaleLowerCase("ja").split(/\s+/).filter(Boolean)
    return fallback
      .filter((page) => words.every((word) => page.text.includes(word)))
      .map(({ url, title, excerpt }) => ({ url, title, excerpt, html: false }))
  }

  const search = async (query: string): Promise<Result[] | null> => {
    const engine = await loadPagefind()
    if (engine === null) return searchFallback(query)
    const found = await engine.debouncedSearch(query)
    // 次の入力で取り消された検索
    if (found === null) return null
    const pages = await Promise.all(found.results.slice(0, 8).map((result) => result.data()))
    return pages.map((page) => ({
      url: page.url,
      title: page.meta.title ?? page.url,
      excerpt: page.excerpt,
      html: true,
    }))
  }

  let active = -1
  const items = () => Array.from(list?.querySelectorAll<HTMLAnchorElement>("a") ?? [])
  const select = (index: number) => {
    const links = items()
    active = links.length === 0 ? -1 : (index + links.length) % links.length
    links.forEach((link, i) => link.setAttribute("aria-selected", String(i === active)))
    links[active]?.scrollIntoView({ block: "nearest" })
  }

  const render = (results: Result[], query: string) => {
    if (list === null || list === undefined || status === null || status === undefined) return
    list.replaceChildren(
      ...results.map((result) => {
        const item = document.createElement("li")
        const link = document.createElement("a")
        link.href = result.url
        link.setAttribute("role", "option")
        const title = document.createElement("span")
        title.className = "search-result-title"
        title.textContent = result.title
        const excerpt = document.createElement("span")
        excerpt.className = "search-result-excerpt"
        // Pagefind の抜粋はサイトの本文から作った HTML で、<mark> 以外はエスケープされている
        if (result.html) excerpt.innerHTML = result.excerpt
        else excerpt.textContent = result.excerpt
        link.append(title, excerpt)
        item.append(link)
        return item
      }),
    )
    status.textContent =
      query === "" ? "" : results.length === 0 ? "見つかりませんでした" : `${results.length} 件`
    select(0)
  }

  input?.addEventListener("input", async () => {
    const query = input.value.trim()
    if (query === "") return render([], "")
    const results = await search(query)
    if (results !== null && input.value.trim() === query) render(results, query)
  })

  input?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault()
      select(active + (event.key === "ArrowDown" ? 1 : -1))
    } else if (event.key === "Enter") {
      const link = items()[active]
      if (link !== undefined) {
        event.preventDefault()
        location.href = link.href
      }
    }
  })

  // ⌘ は Mac だけの印なので、ほかでは Ctrl にする
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll<HTMLElement>(".search-btn .search-kbd").forEach((kbd) => {
      kbd.textContent = "Ctrl K"
    })
  }

  const open = () => {
    if (dialog === null || dialog === undefined || dialog.open) return
    dialog.showModal()
    input?.select()
    // 開いたときに読み込み始めておくと、最初の検索を待たせない
    void loadPagefind()
  }

  document.querySelectorAll("[data-search-open]").forEach((button) => {
    button.addEventListener("click", open)
  })
  document.addEventListener("keydown", (event) => {
    if (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) {
      event.preventDefault()
      if (dialog?.open) dialog.close()
      else open()
    }
  })
  // 枠の外 (背景) を押したら閉じる
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close()
  })
</script>
