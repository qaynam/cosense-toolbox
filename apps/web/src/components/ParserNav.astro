---
// parser のドキュメント間を移動するサブナビ。
// ヘッダのナビはモバイルで display:none になるので、そちらには足さない。
const links = [
	{ href: "/parser/", label: "ドキュメント" },
	{ href: "/parser/demo/", label: "デモ" },
];
const current = Astro.url.pathname;
---

<nav class="pkg-nav">
	<span class="pkg-nav-name">@cosense-toolbox/parser</span>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href} aria-current={current === link.href ? "page" : undefined}>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
