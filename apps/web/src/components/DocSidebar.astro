---
import { DOC_GROUPS } from "../lib/docs"

const current = Astro.url.pathname
---

<nav class="doc-nav" aria-label="ドキュメント">
  <a class="doc-nav-name" href="/docs/"> Cosense Toolbox Docs </a>
  {
    DOC_GROUPS.map((group) => (
      <section>
        <h2>{group.label}</h2>
        <ul>
          {group.pages.map((page) => (
            <li>
              <a href={page.href} aria-current={current === page.href ? "page" : undefined}>
                {page.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <a
    class="doc-nav-repo"
    href="https://github.com/qaynam/cosense-toolbox"
    target="_blank"
    rel="noopener noreferrer"
  >
    GitHub ↗
  </a>
</nav>
