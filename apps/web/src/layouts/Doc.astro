---
import type { MarkdownHeading } from 'astro';
import DocSidebar from '../components/DocSidebar.astro';
import DocToc from '../components/DocToc.astro';
import { adjacentDocs } from '../lib/parser-docs';
import Base from './Base.astro';

interface Frontmatter {
	title: string;
	description?: string;
}

interface Props {
	/** Markdown ページから渡る。`.astro` ページは title / description を直接渡す */
	frontmatter?: Frontmatter;
	headings?: MarkdownHeading[];
	title?: string;
	description?: string;
}

const { frontmatter, headings = [], title, description } = Astro.props;
const pageTitle = frontmatter?.title ?? title ?? '@cosense-toolbox/parser';
const pageDescription =
	frontmatter?.description ?? description ?? 'Cosense 記法を位置情報つきの AST に変換する npm パッケージ';
const { prev, next } = adjacentDocs(Astro.url.pathname);
---

<Base title={pageTitle} description={pageDescription} image="/og-parser.png" wide>
	<div class="doc-shell">
		<DocSidebar />
		<article class="doc">
			<slot />
			{
				(prev !== undefined || next !== undefined) && (
					<nav class="doc-pager" aria-label="前後のページ">
						{prev !== undefined ? (
							<a href={prev.href} rel="prev">
								<span>前へ</span>
								{prev.label}
							</a>
						) : (
							<span />
						)}
						{next !== undefined && (
							<a class="is-next" href={next.href} rel="next">
								<span>次へ</span>
								{next.label}
							</a>
						)}
					</nav>
				)
			}
		</article>
		<DocToc headings={headings} />
	</div>
</Base>

<script>
	// 見出しにパーマリンクを付ける。id は Astro が Markdown から振ったものを使う。
	// クリックでリンクを開かず、絶対 URL をクリップボードへ入れる。
	const doc = document.querySelector('.doc');

	for (const heading of doc?.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]') ?? []) {
		const anchor = document.createElement('a');
		anchor.className = 'heading-anchor';
		anchor.href = `#${heading.id}`;
		anchor.textContent = '#';
		anchor.setAttribute('aria-label', `「${heading.textContent}」へのリンクをコピー`);
		heading.append(anchor);
	}

	let restore: ReturnType<typeof setTimeout> | undefined;

	doc?.addEventListener('click', (event) => {
		const anchor = (event.target as HTMLElement).closest<HTMLAnchorElement>('.heading-anchor');
		if (anchor === null || anchor === undefined) return;
		event.preventDefault();

		const hash = anchor.getAttribute('href') ?? '';
		// 開いている場所は変わらないので、スクロールを起こさない replaceState にする
		history.replaceState(null, '', hash);

		navigator.clipboard
			.writeText(new URL(hash, location.href).href)
			.then(() => {
				anchor.classList.add('is-copied');
				clearTimeout(restore);
				restore = setTimeout(() => anchor.classList.remove('is-copied'), 1400);
			})
			// クリップボードを使えない文脈 (http など) では、URL の更新だけで終える
			.catch(() => {});
	});
</script>
