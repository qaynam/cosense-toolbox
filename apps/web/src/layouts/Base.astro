---
import "../styles/global.css";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  app?: boolean;
  /** ドキュメントのように 3 カラムを並べる画面で、本文の枠を広げる */
  wide?: boolean;
}
const {
  title = "Cosense Toolbox",
  description = "Cosense (旧Scrapbox) をもっと面白く、もっと強力に使うためのツール群",
  image,
  app = false,
  wide = false,
} = Astro.props;
const fullTitle =
  title === "Cosense Toolbox" ? title : `${title} — Cosense Toolbox`;

const siteUrl = Astro.site ?? new URL("https://cosense-toolbox.qaynam.dev");
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image ?? "/og.png", siteUrl);
---

<!doctype html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cosense Toolbox" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("cosense-toolbox-theme");
          if (!t)
            t = matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={app ? "is-app" : undefined}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img class="logo" src="/beaver.png" alt="" width="30" height="30" />
          <span>Cosense Toolbox</span>
        </a>
        <div class="header-actions">
          <nav>
            <a href="/parser/">パーサー</a>
            <a href="/scripts/">userscript</a>
            <a href="/builder/">テーマ作成</a>
            <a href="/guide/">使い方</a>
            <a href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a>
          </nav>
          <button
            class="icon-btn"
            data-theme-toggle
            aria-label="テーマ切替"
            type="button">☀</button
          >
        </div>
      </div>
    </header>

    <main class={app ? "main-app" : wide ? "wrap wrap-wide" : "wrap"}>
      <slot />
    </main>

    {
      !app && (
        <footer class="site-footer">
          <div class="wrap">
            <p>
              Cosense Toolbox / Cosense
              をもっと面白く、もっと強力に使うためのツール群
            </p>
            <p class="foot-links">
              <a href={SITE.github} target="_blank" rel="noopener">
                GitHub ↗
              </a>
            </p>
          </div>
        </footer>
      )
    }

    <!-- カード→詳細をギャラリーの上にかぶせるモーダルの差し込み先 -->
    <div id="modal-root"></div>

    <script>
      const THEME_KEY = "cosense-toolbox-theme";

      function esc(s: string) {
        return String(s).replace(
          /[&<>"]/g,
          (c) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] || c,
        );
      }

      async function clip(text: string, btn?: HTMLElement | null) {
        try {
          await navigator.clipboard.writeText(text);
          if (btn) {
            const l = (btn.querySelector(".label") as HTMLElement) || btn;
            const prev = l.textContent;
            btn.classList.add("copied");
            l.textContent = "コピー済み ✓";
            setTimeout(() => {
              btn.classList.remove("copied");
              l.textContent = prev;
            }, 1400);
          }
        } catch {}
      }

      function syncTheme() {
        const dark =
          document.documentElement.getAttribute("data-theme") !== "light";
        document.querySelectorAll("[data-theme-toggle]").forEach((b) => {
          b.textContent = dark ? "☀" : "🌙";
          b.setAttribute(
            "aria-label",
            dark ? "ライトモードに切替" : "ダークモードに切替",
          );
        });
      }

      /* ---------- モーダル（ギャラリーの上にかぶせる） ---------- */
      function modalRoot() {
        return document.getElementById("modal-root");
      }
      function isOverlayOpen() {
        const r = modalRoot();
        return !!(r && r.children.length);
      }
      function clearOverlay() {
        modalRoot()?.replaceChildren();
        document.documentElement.classList.remove("modal-open");
      }
      async function openModal(href: string, push = true) {
        let html: string;
        try {
          const res = await fetch(href);
          if (!res.ok) throw new Error();
          html = await res.text();
        } catch {
          location.href = href;
          return;
        }
        const doc = new DOMParser().parseFromString(html, "text/html");
        const scrim = doc.querySelector("[data-modal-scrim]");
        const root = modalRoot();
        if (!scrim || !root) {
          location.href = href;
          return;
        }
        root.replaceChildren(document.importNode(scrim, true));
        document.documentElement.classList.add("modal-open");
        root.querySelector<HTMLElement>(".modal-card")?.scrollTo(0, 0);
        if (push) history.pushState({ csModal: href }, "", href);
        syncTheme();
      }
      function requestClose() {
        if (isOverlayOpen()) history.back();
        else location.href = "/scripts/";
      }
      window.addEventListener("popstate", () => {
        const st = history.state as { csModal?: string } | null;
        if (st && st.csModal) {
          if (!isOverlayOpen()) openModal(st.csModal, false);
        } else if (isOverlayOpen()) {
          clearOverlay();
        }
      });

      /* ---------- クリック委譲 ---------- */
      document.addEventListener("click", async (e) => {
        const t = e.target as HTMLElement;

        // 遷移させずモーダルにするのは、背景のギャラリーを残すため。
        // 修飾キー付きと中クリックだけは、別タブで開く既定の動きに任せる。
        const cardLink = t.closest<HTMLAnchorElement>(".card-link");
        if (
          cardLink &&
          !(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) &&
          (e as MouseEvent).button === 0
        ) {
          e.preventDefault();
          openModal(cardLink.getAttribute("href") || "/");
          return;
        }

        if (t.closest("[data-modal-close]")) {
          e.preventDefault();
          requestClose();
          return;
        }
        const scrim = t.closest("[data-modal-scrim]");
        if (scrim && !t.closest(".modal-card")) {
          e.preventDefault();
          requestClose();
          return;
        }

        const demoToggle = t.closest<HTMLElement>("[data-css-demo-toggle]");
        if (demoToggle) {
          const demo = demoToggle.closest<HTMLElement>(".css-demo");
          const iframe = demo?.querySelector("iframe");
          if (demo && iframe) {
            const on = demo.dataset.on !== "true";
            demo.dataset.on = String(on);
            demoToggle.setAttribute("aria-pressed", String(on));
            demoToggle.textContent = on
              ? "userCSS を解除 ■"
              : "userCSS を適用 ▶";
            iframe.contentWindow?.postMessage({ type: "toggle", on }, "*");
          }
          return;
        }

        const copyBtn = t.closest<HTMLElement>("[data-copy]");
        if (copyBtn) {
          clip(copyBtn.getAttribute("data-copy") || "", copyBtn);
          return;
        }
        const themeBtn = t.closest<HTMLElement>("[data-theme-toggle]");
        if (themeBtn) {
          const next =
            document.documentElement.getAttribute("data-theme") === "light"
              ? "dark"
              : "light";
          // 色が一斉に切り替わるよう、この 1 フレームだけ遷移を止める
          document.documentElement.classList.add("is-theme-switching");
          document.documentElement.setAttribute("data-theme", next);
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              document.documentElement.classList.remove("is-theme-switching");
            });
          });
          try {
            localStorage.setItem(THEME_KEY, next);
          } catch {}
          syncTheme();
          return;
        }
      });

      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          document.querySelector("[data-modal-scrim]")
        ) {
          requestClose();
        }
      });

      syncTheme();
    </script>
  </body>
</html>
