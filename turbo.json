{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["eslint.config.js", "prettier.config.mjs", ".prettierignore"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"],
      "outputs": []
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/prettier.config.mjs",
        "$TURBO_ROOT$/.prettierignore"
      ],
      "outputs": []
    },
    "//#lint:root": {
      "inputs": ["eslint.config.js", "prettier.config.mjs", "scripts/**"],
      "outputs": []
    },
    "//#format:check:root": {
      "inputs": ["*", "scripts/**", ".github/**", ".vscode/**"],
      "outputs": []
    }
  }
}
