{
  "name": "@cosense-toolbox/markdown",
  "version": "0.1.0-beta.8",
  "description": "Read Markdown (CommonMark, GFM and $math$) as a Cosense page: get the AST, or the Cosense notation text to paste.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check:public-types": "bun ../../tools/public-types/src/check.ts",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@cosense-toolbox/parser": "workspace:*",
    "@types/mdast": "^4.0.4",
    "effect": "^3.22.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "cosense",
    "scrapbox",
    "markdown",
    "mdast",
    "converter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaynam/cosense-toolbox.git",
    "directory": "packages/markdown"
  }
}
