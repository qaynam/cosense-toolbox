{
  "name": "@cosense-toolbox/style",
  "version": "0.1.0-beta.10",
  "description": "Default stylesheet for the HTML that @cosense-toolbox/parser renders.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "style": "./style.css",
  "exports": {
    ".": "./style.css",
    "./style.css": "./style.css",
    "./csn.css": "./csn.css",
    "./package.json": "./package.json"
  },
  "files": [
    "style.css",
    "csn.css",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cosense",
    "scrapbox",
    "css",
    "stylesheet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaynam/cosense-toolbox.git",
    "directory": "packages/style"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "typescript": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
