{
  "name": "@cosense-toolbox/astro",
  "version": "0.1.0-beta.0",
  "description": "Astro integration for cosense-x: use .csn / .csnx (Cosense notation) as pages and content collections.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server.js": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@cosense-toolbox/cosense-x": "workspace:*",
    "@cosense-toolbox/lsp": "workspace:*",
    "@cosense-toolbox/parser": "workspace:*",
    "effect": "^3.22.1",
    "shiki": "^4.2.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "astro": "7.2.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0",
    "vite": "^8.0.13",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "cosense",
    "scrapbox",
    "astro",
    "astro-integration",
    "withastro",
    "ssg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaynam/cosense-toolbox.git",
    "directory": "packages/astro-cosense"
  }
}
