        {
          "type": "decoration",
          "value": "x",
          "bold": false,
          "italic": false,
          "strike": false,
          "underline": false,
          "sizeLevel": 0,
          "children": [
            {
              "type": "text",
              "value": "x"
            }
          ],
          "markers": ["|", "="]
