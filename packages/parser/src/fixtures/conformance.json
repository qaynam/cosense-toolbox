    {
      "description": "インラインコードが始まる括弧は記法にならない (Cosense Web はコードを先に読む)",
      "input": "[* 太字の中の `code` です]",
      "expected": [
        {
          "type": "text",
          "value": "[* 太字の中の "
        },
        {
          "type": "inlineCode",
          "value": "code"
        },
        {
          "type": "text",
          "value": " です]"
        }
      ]
    },
    {
      "description": "インラインコードが始まる括弧はリンクにもならない",
      "input": "[リンク `x` です]",
      "expected": [
        {
          "type": "text",
          "value": "[リンク "
        },
        {
          "type": "inlineCode",
          "value": "x"
        },
        {
          "type": "text",
          "value": " です]"
        }
      ]
    },
    {
      "description": "括弧の中身がインラインコードだけでも記法にならない",
      "input": "[`code`]",
