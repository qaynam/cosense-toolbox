      "expected": [
        {
          "type": "decoration",
          "value": "x",
          "bold": true,
          "italic": false,
          "strike": false,
          "underline": false,
          "sizeLevel": 0,
          "children": [
            {
              "type": "text",
              "value": "x"
            }
