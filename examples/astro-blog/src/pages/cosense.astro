---
/**
 * 公開プロジェクトのページを、ビルド時に Cosense の API から取ってきて描画する。
 * ネットワークにつながらなければ、このページだけ案内を出して飛ばす。
 */
import { fetchPageText } from '@cosense-toolbox/cosense-x/fetch'
import { parse } from '@cosense-toolbox/parser'
import { toHtml } from '@cosense-toolbox/parser/compile'
import Base from '../layouts/Base.astro'

const project = 'help-jp'
const title = 'ブラケティング'

let html: string | null = null
try {
  const text = await fetchPageText(project, title)
  html = toHtml(parse(text), {
    pageUrl: (target) => `https://scrapbox.io/${project}/${encodeURIComponent(target)}`,
  })
} catch (error) {
  console.warn(`[cosense] ${project}/${title} を取得できなかった:`, error)
}
---

<Base title={title}>
  <p>
    <a href={`https://scrapbox.io/${project}/${encodeURIComponent(title)}`}>/{project}/{title}</a>
    をビルド時に取ってきて描画している。
  </p>
  {html === null ? <p>取得できなかった (オフラインでビルドした)。</p> : <Fragment set:html={html} />}
</Base>
