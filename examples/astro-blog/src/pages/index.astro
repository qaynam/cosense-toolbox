---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
)
---

<Base title="記事一覧">
  <h1 class="mb-6 text-2xl font-bold">記事一覧</h1>
  <ul class="space-y-4">
    {
      posts.map((post) => (
        <li>
          <a class="text-lg font-bold text-blue-700 underline" href={`/posts/${encodeURIComponent(post.id)}/`}>{post.data.title}</a>
          {post.data.date && <time class="ml-2 text-sm text-gray-500">{post.data.date.toISOString().slice(0, 10)}</time>}
          <p class="text-sm text-gray-700">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
