---
import { getCollection, render } from 'astro:content'
import graph from 'virtual:cosense-x/graph'
import Base from '../../layouts/Base.astro'
import { pageUrl } from '../../urls'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)

// グラフの id はプロジェクトのルートからのパスで、content collection の filePath と同じ形。
const id = post.filePath ?? ''
const pageLink = (pageId: string) => {
  const page = graph.pages[pageId]
  return page ? { href: pageUrl(page), title: page.title } : null
}
const backlinks = (graph.backlinks[id] ?? []).map(pageLink).filter((link) => link !== null)
const twoHop = graph.twoHop[id] ?? []
---

<Base title={post.data.title} description={post.data.description}>
  <!-- cosense-{記法}: の modifier で、記事の中の記法ごとに utility を当てる -->
  <article
    class="cosense cosense-title:text-4xl cosense-hashtag:text-emerald-700 cosense-link:hover:underline cosense-code:bg-amber-50"
  >
    <Content />
  </article>

  {
    backlinks.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-2 text-lg font-bold">このページにリンクしているページ</h2>
        <ul class="list-disc pl-6">
          {backlinks.map((link) => (
            <li>
              <a class="text-blue-700 underline" href={link.href}>{link.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    twoHop.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-2 text-lg font-bold">2 hop リンク</h2>
        {twoHop.map((group) => (
          <div class="two-hop">
            <h3 class="mt-3 font-bold">{group.via} 経由</h3>
            <ul class="list-disc pl-6">
              {group.pages.map(pageLink).map(
                (link) =>
                  link && (
                    <li>
                      <a class="text-blue-700 underline" href={link.href}>{link.title}</a>
                    </li>
                  ),
              )}
            </ul>
          </div>
        ))}
      </section>
    )
  }
</Base>
