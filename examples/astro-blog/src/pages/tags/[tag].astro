---
import graph from 'virtual:cosense-x/graph'
import Base from '../../layouts/Base.astro'
import { pageUrl } from '../../urls'

export function getStaticPaths() {
  return Object.values(graph.tags).map((tag) => ({ params: { tag: tag.name }, props: { tag } }))
}

const { tag } = Astro.props
const pages = tag.pages.map((id) => graph.pages[id]).filter((page) => page !== undefined)
---

<Base title={`#${tag.name}`}>
  <h1 class="mb-6 text-2xl font-bold">#{tag.name}</h1>
  <ul class="list-disc pl-6">
    {
      pages.map((page) => (
        <li>
          <a class="text-blue-700 underline" href={pageUrl(page)}>{page.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
