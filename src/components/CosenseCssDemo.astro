---
interface Props {
	css: string;
}
const { css } = Astro.props;

const indentSpans = (n: number) => '<span><span class="pad"></span></span>'.repeat(n);
const line = (n: number, text: string, cls = '') =>
	`<div class="line ${cls}"><span class="indent-mark">${indentSpans(n)}</span><span class="text">${text}</span></div>`;
const codeLine = (c: string) =>
	`<div class="line"><span class="indent"><code class="code-body">${c}</code></span></div>`;

const mock = [
	`<div class="line line-title"><span class="text">デモページ</span></div>`,
	`<div class="line section-title"><span class="text">はじめに</span></div>`,
	line(1, 'これはふつうの行です'),
	line(2, 'ネストした行（カーソル行）', 'cursor-line'),
	line(3, 'さらにネストした行'),
	line(6, '深いインデント → 虹色になる'),
	`<div class="line section-title"><span class="text">コード例</span></div>`,
	`<div class="code-block">` +
		`<div class="line code-block-title"><span class="indent"><code class="code-body">code:demo.js</code></span></div>` +
		['const a = 1;', 'const b = 2;', 'function sum() {', '  return a + b;', '}'].map(codeLine).join('') +
		`</div>`,
].join('');

const baseCss = `
*{box-sizing:border-box}
body{margin:0;background:#111;color:#dcdcdc;font:14px/1.7 -apple-system,BlinkMacSystemFont,'Hiragino Sans','Noto Sans JP',sans-serif}
.app{position:relative;padding:18px 22px 30px 130px}
.lines{position:relative}
.line{position:relative;min-height:1.7em;padding:1px 0;white-space:pre-wrap}
.line.line-title{font-size:1.7em;font-weight:700;margin-bottom:.4em;color:#fff}
.line.section-title{font-weight:700;font-size:1.15em;margin-top:.9em;color:#f1f1f1}
.indent-mark{display:inline-flex;height:1.7em;vertical-align:top}
.indent-mark>span{display:inline-block;width:1.5em;height:100%;position:relative}
.indent-mark .pad{display:block;width:100%;height:100%}
.code-block{background:#1c1c1c;border-radius:6px;margin:.6em 0;padding:.3em 0}
.code-block .line{padding-left:1.6em}
.code-block-title{color:#777}
.code-body{font-family:'SF Mono',Menlo,monospace;font-size:.92em;color:#c7d0dc}
`;

const srcdoc = `<!doctype html><html lang="ja"><head><meta charset="utf-8"><style>${baseCss}</style><style id="user">${css}</style></head><body><div class="app"><div class="lines">${mock}</div></div><script>(function(){var u=document.getElementById('user');u.disabled=true;window.addEventListener('message',function(e){if(e.data&&e.data.type==='toggle'){u.disabled=!e.data.on;}});})();<\/script></body></html>`;
---

<!-- トグル挙動は Base.astro の委譲ハンドラ([data-css-demo-toggle])で処理。スタイルは global.css。 -->
<div class="css-demo" data-on="false">
	<div class="css-demo-bar">
		<span class="css-demo-title">疑似Cosenseページ・ライブプレビュー</span>
		<button class="btn primary css-demo-toggle" data-css-demo-toggle aria-pressed="false" type="button">userCSS を適用 ▶</button>
	</div>
	<iframe class="css-demo-frame" srcdoc={srcdoc} title="userCSS live demo" sandbox="allow-scripts" loading="lazy"></iframe>
</div>
