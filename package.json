{
  "name": "cosense-toolbox",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "deploy": "bun run --filter '@cosense-toolbox/web' deploy:ci",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "npm:publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "prettier": "^3.9.6",
    "turbo": "^2.3.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
