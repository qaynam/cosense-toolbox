{
  "name": "cosense-toolbox",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "deploy": "bun run --filter '@cosense-toolbox/web' deploy:ci",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint eslint.config.js prettier.config.mjs scripts",
    "format": "prettier --write .",
    "format:check": "turbo run format:check format:check:root",
    "format:check:root": "prettier --check --ignore-unknown \"*\" scripts .github .vscode",
    "npm:publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
